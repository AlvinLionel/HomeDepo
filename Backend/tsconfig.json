{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "rootDir": "./",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true
    },
    "include": [
        "server.js",
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}