PORT=5000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=homedepo

MODERATOR_EMAILS=moderator@example.com
NOMINATIM_USER_AGENT=HomeX/1.0 (contact: support@your-domain.com)

# SMTP settings (Mailtrap sandbox defaults are for development only)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Legacy credentials are used when SMTP_USER/SMTP_PASS are blank.
MAILTRAP_USER=
MAILTRAP_PASS=
EMAIL_NAME=HomeX
EMAIL_USER=

# Public customer support contact details (leave optional fields blank to hide)
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_HOURS=
